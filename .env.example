# Voice AI – Sarvam + Plivo configuration
# Copy this file to .env and fill in your credentials.

# ---------------------------------------------------------------------------
# Sarvam AI (STT · TTS · LLM)
# ---------------------------------------------------------------------------
SARVAM_API_KEY=YOUR_SARVAM_API_KEY_HERE

# Some older Sarvam endpoints still require this secondary key.
# Leave blank if not provided by the Sarvam dashboard.
SARVAM_SUBSCRIPTION_KEY=

# Model names — change only if you are on a specific model tier.
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_CHAT_MODEL=sarvam-105b

# Language code for STT / TTS (BCP-47, e.g. en-IN, hi-IN, ta-IN).
SARVAM_LANGUAGE_CODE=en-IN

# ---------------------------------------------------------------------------
# Microphone / VAD
# ---------------------------------------------------------------------------
# Device index (run `python -m sounddevice` to list). -1 = default mic.
MIC_DEVICE_INDEX=-1

# VAD aggressiveness 0–3 (higher = more aggressive filtering).
VAD_AGGRESSIVENESS=3

# Silence (ms) that ends an utterance.
SILENCE_END_MS=400

# Hard cap on utterance length in ms.
MAX_UTTERANCE_MS=60000

# Audio (ms) kept before the first voiced frame (prevents clipping).
PRE_SPEECH_MS=200

# Minimum speech (ms) to be considered a real utterance.
MIN_SPEECH_MS=250

# ---------------------------------------------------------------------------
# Pipeline behaviour
# ---------------------------------------------------------------------------
# How many user+assistant turns to keep in the LLM context window.
MAX_HISTORY_TURNS=8

# Retry behaviour for Sarvam HTTP calls.
RETRY_ATTEMPTS=3
RETRY_BACKOFF_S=2.0

# System prompt for the LLM. Keep short for phone deployments.
SYSTEM_PROMPT=You are a helpful and friendly voice AI assistant. Keep responses short and conversational — 1 to 3 sentences. Use a warm, clear tone suitable for phone conversations.

# ---------------------------------------------------------------------------
# Plivo (telephony — optional)
# ---------------------------------------------------------------------------
# Get these from https://console.plivo.com/dashboard/
PLIVO_AUTH_ID=YOUR_PLIVO_AUTH_ID_HERE
PLIVO_AUTH_TOKEN=YOUR_PLIVO_AUTH_TOKEN_HERE

# Host / port for the FastAPI server.
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Your Plivo DID that makes outbound calls.
PLIVO_CALLER_NUMBER=+1XXXXXXXXXX
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/?appName=<app>
MONGO_DB=voice_ai
MONGO_COLLECTION=calls
PLIVO_PROVIDER_CURRENCY=USD
PLIVO_USD_TO_INR=95.83
